{
  "name": "template-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "The mobile app of the product template: an Expo app for iOS and Android, one more client of the template's API",
  "license": "UNLICENSED",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@zigordev/tokens": "workspace:*",
    "@zigordev/ui-native": "workspace:*",
    "better-auth": "catalog:shipped",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-linking": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-status-bar": "catalog:",
    "openapi-react-query": "catalog:",
    "react": "catalog:mobile",
    "react-dom": "catalog:mobile",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "template-api-client": "workspace:*",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@zigordev/dev": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
