{
  "name": "@zigordev/rum",
  "version": "0.0.0",
  "private": true,
  "description": "Browser monitoring for zigordev web apps: Grafana Faro in the page, sending to the product's own address, with no personal data leaving the browser",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "catalog:shipped",
    "@grafana/faro-web-tracing": "catalog:shipped"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zigordev/dev": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
