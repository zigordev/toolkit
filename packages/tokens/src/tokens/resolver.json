{
  "name": "zigordev design system",
  "version": "2025.10",
  "description": "Shared components for every app, with each product in its own colours. The base set is shared; the product chooses the colours, and the mode chooses light or dark.",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "base/typography.tokens.json"
        },
        {
          "$ref": "base/space.tokens.json"
        },
        {
          "$ref": "base/shape.tokens.json"
        },
        {
          "$ref": "base/motion.tokens.json"
        },
        {
          "$ref": "base/layout.tokens.json"
        },
        {
          "$ref": "base/controls.tokens.json"
        },
        {
          "$ref": "base/brand.tokens.json"
        },
        {
          "$ref": "base/roles.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "product": {
      "description": "A product's colours: its background, its accent, and the status colours moved away from that accent. The default is the template's.",
      "contexts": {
        "default": [
          {
            "$ref": "color/default/palette-brand.tokens.json"
          },
          {
            "$ref": "color/default/palette-status.tokens.json"
          }
        ],
        "gpool": [
          {
            "$ref": "color/gpool/palette-brand.tokens.json"
          },
          {
            "$ref": "color/gpool/palette-status.tokens.json"
          }
        ],
        "trading-bot": [
          {
            "$ref": "color/trading-bot/palette-brand.tokens.json"
          },
          {
            "$ref": "color/trading-bot/palette-status.tokens.json"
          }
        ],
        "cv": [
          {
            "$ref": "color/cv/palette-brand.tokens.json"
          },
          {
            "$ref": "color/cv/palette-status.tokens.json"
          }
        ]
      },
      "default": "default"
    },
    "mode": {
      "description": "Light or dark: which half of each ramp the scales use, the surfaces and the elevation.",
      "contexts": {
        "light": [
          {
            "$ref": "color/scale-light.tokens.json"
          },
          {
            "$ref": "mode/light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "color/scale-dark.tokens.json"
          },
          {
            "$ref": "mode/dark.tokens.json"
          }
        ]
      },
      "default": "dark"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/product"
    },
    {
      "$ref": "#/modifiers/mode"
    }
  ]
}
