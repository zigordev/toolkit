{
  "name": "@zigordev/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Sign-in for zigordev apps on Better Auth: email with a password, passkeys, two-factor and Google, sessions in the app's own database, account deletion, and the parts for Fastify, Next.js and the browser",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:shipped",
    "better-auth": "catalog:shipped"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@zigordev/api": "workspace:^",
    "@zigordev/otel": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@zigordev/api": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@zigordev/api": "workspace:*",
    "@zigordev/config": "workspace:*",
    "@zigordev/dev": "workspace:*",
    "@zigordev/otel": "workspace:*",
    "@zigordev/test": "workspace:*",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "next": "catalog:",
    "pg": "catalog:shipped",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
