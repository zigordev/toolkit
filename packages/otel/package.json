{
  "name": "@zigordev/otel",
  "version": "0.0.0",
  "private": true,
  "description": "Telemetry for zigordev services: traces and metrics over OpenTelemetry, structured logs with the trace in them, and the answer of the health route",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/core": "catalog:shipped",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:shipped",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:shipped",
    "@opentelemetry/instrumentation": "catalog:shipped",
    "@opentelemetry/instrumentation-http": "catalog:shipped",
    "@opentelemetry/instrumentation-pg": "catalog:shipped",
    "@opentelemetry/instrumentation-runtime-node": "catalog:shipped",
    "@opentelemetry/instrumentation-undici": "catalog:shipped",
    "@opentelemetry/resources": "catalog:shipped",
    "@opentelemetry/sdk-node": "catalog:shipped",
    "@opentelemetry/sdk-trace": "catalog:shipped",
    "pino": "catalog:shipped"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@types/node": "catalog:",
    "@zigordev/dev": "workspace:*",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigordev/toolkit.git",
    "directory": "packages/otel"
  }
}
