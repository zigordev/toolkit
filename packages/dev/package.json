{
  "name": "@zigordev/dev",
  "version": "0.0.0",
  "description": "The developer setup every zigordev repo shares: the zigordev command, the Biome config, the TypeScript bases, the git hooks and the commit rules",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "zigordev": "./bin/zigordev.js"
  },
  "files": [
    "bin",
    "dist",
    "biome.json",
    "commitlint.js",
    "lefthook.yml",
    "shared",
    "tsconfig"
  ],
  "exports": {
    "./biome": "./biome.json",
    "./commitlint": "./commitlint.js",
    "./lefthook.yml": "./lefthook.yml",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/library.json": "./tsconfig/library.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@commitlint/cli": "^21.2.0",
    "lefthook": "^2.2.0",
    "markdownlint-cli2": "^0.24.0"
  },
  "devDependencies": {
    "@commitlint/lint": "catalog:",
    "@commitlint/load": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigordev/toolkit.git",
    "directory": "packages/dev"
  }
}
